{
  "name": "contentful-mce-sync",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@contentful/app-sdk": "^4.29.1",
    "@contentful/f36-components": "4.81.1",
    "@contentful/f36-tokens": "4.2.0",
    "@contentful/react-apps-toolkit": "1.2.16",
    "contentful-management": "10.46.4",
    "emotion": "10.0.27",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "install-ci": "npm ci",
    "build": "tsc --noEmit && vite build && contentful-app-scripts build-functions --ci",
    "build-functions": "contentful-app-scripts build-functions --ci",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "create-app-definition": "contentful-app-scripts create-app-definition",
    "add-locations": "contentful-app-scripts add-locations",
    "upsert-actions": "contentful-app-scripts upsert-actions",
    "upload": "contentful-app-scripts upload --bundle-dir ./build",
    "setup-app-definition": "node scripts/setup-app-definition.mjs",
    "upload-ci": "contentful-app-scripts upload --ci --bundle-dir ./build --organization-id $CONTENTFUL_ORG_ID --definition-id $CONTENTFUL_APP_DEF_ID --token $CONTENTFUL_ACCESS_TOKEN"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@contentful/app-scripts": "^4.1.13",
    "@contentful/node-apps-toolkit": "^3.11.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.3.1",
    "@tsconfig/recommended": "1.0.8",
    "@types/node": "^22.13.5",
    "@types/react": "18.3.13",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.0.3",
    "cross-env": "7.0.3",
    "jsdom": "^26.0.0",
    "typescript": "4.9.5",
    "vite": "^6.2.2",
    "vitest": "^4.1.11",
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "15.15.0",
    "typescript-eslint": "^8.54.0"
  },
  "homepage": ".",
  "description": "Sync Contentful content types into Salesforce Marketing Cloud Engagement Data Extensions, including Shared Data Extensions in the parent BU.",
  "license": "MIT",
  "engines": {
    "node": ">=20 <22"
  }
}
